{
  "name": "@shifang37/vagent",
  "version": "0.1.0",
  "private": true,
  "description": "A DeepSeek video-creation agent with a custom LangGraph harness",
  "type": "module",
  "bin": {
    "vagent": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@langchain/core": "^1.2.13",
    "@langchain/deepseek": "^1.1.15",
    "@langchain/langgraph": "^1.4.18",
    "commander": "^15.0.0",
    "dotenv": "^18.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
