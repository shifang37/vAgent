# Copy to .env for local development; never commit the real key.
DEEPSEEK_API_KEY=
VAGENT_DEEPSEEK_MODEL=deepseek-flash
# Budget for serialized model messages and tool definitions, in UTF-8 bytes.
VAGENT_CONTEXT_BYTES=98304
# Optional: use a trusted local skills directory instead of bundled skills.
# Without this override, builtin skills are merged with VAGENT_HOME/skills
# (builtin names win; invalid user files are reported and skipped).
# VAGENT_SKILLS_DIR=./skills
# Optional: override ~/.vagent for isolated local state.
# VAGENT_HOME=./.vagent
# Optional exact-answer cache, only used by run/chat --read-only.
# VAGENT_REDIS_URL=redis://localhost:6379/0
# VAGENT_CACHE_TTL=3600
# Enable the bundled read-only video planning MCP server (stdio).
# VAGENT_MCP_LOCAL=1
# Optional trusted stdio servers; see docs/MCP.md for explicit tool allowlists.
# VAGENT_MCP_CONFIG=./mcp.local.json
# Video tools: off (default), mock (simulation), or live (paid generation).
# C2 downloads and verifies MP4 locally; live account and billing validation is pending in C3.
# Video settings take effect after restart. Saving them sends no generation request.
# VAGENT_VIDEO_MODE=off
# Separate Beijing video key and its business workspace (a lowercase DNS label).
# VAGENT_DASHSCOPE_KEY=
# VAGENT_DASHSCOPE_WORKSPACE_ID=
# Frozen live capability: 5 seconds, 720P, 16:9; no model/region fallback.
# VAGENT_VIDEO_PROVIDER=wan
# VAGENT_VIDEO_MODEL=wan2.7-t2v-2026-06-12
# VAGENT_VIDEO_REGION=cn-beijing
# Decimal CNY limit per Job; current reference estimate is 3.00, actual bill unknown.
# VAGENT_VIDEO_MAX_JOB_COST=3.00
# M3 E2 providers: one Key per provider; set VAGENT_VIDEO_PROVIDER to the chosen one.
# Kling Singapore direct (kling-3.0-turbo, native audio, USD + VIDEO_UNIT estimate).
# VAGENT_KLING_API_KEY=
# VAGENT_KLING_MAX_JOB_COST=0.60
# VAGENT_KLING_MAX_RUN_COST=2.40
# VAGENT_KLING_MAX_JOB_UNITS=4
# VAGENT_KLING_MAX_RUN_UNITS=16
# fal standard silent relay (fal-ai/kling-video/v3/standard/text-to-video, USD).
# FAL_KEY=
# VAGENT_FAL_MAX_JOB_COST=0.50
# VAGENT_FAL_MAX_RUN_COST=2.00
