# Copy to .env for local development; never commit the real key.
DEEPSEEK_API_KEY=
VAGENT_DEEPSEEK_MODEL=deepseek-flash
# Budget for serialized model messages and tool definitions, in UTF-8 bytes.
VAGENT_CONTEXT_BYTES=65536
# Optional: use a trusted local skills directory instead of bundled skills.
# VAGENT_SKILLS_DIR=./skills
# Optional: override ~/.vagent for isolated local state.
# VAGENT_HOME=./.vagent
# Optional exact-answer cache, only used by run/chat --read-only.
# VAGENT_REDIS_URL=redis://localhost:6379/0
# VAGENT_CACHE_TTL=3600
# Enable the bundled read-only video planning MCP server (stdio).
# VAGENT_MCP_LOCAL=1
# Optional trusted stdio servers; see docs/MCP.md for explicit tool allowlists.
# VAGENT_MCP_CONFIG=./mcp.local.json
# Startup-only video tools: off (default) or mock (simulated, no playable media).
# B3 supports durable waits; automatic JobWorker lifecycle and Job UI follow in B4.
# VAGENT_VIDEO_MODE=off
